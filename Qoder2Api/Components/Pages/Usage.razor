@page "/usage"
@using Qoder2Api
@using Qoder2Api.Components
@using Qoder2Api.Components.Layout
@using Qoder2Api.Models
@using Qoder2Api.Services.Qoder
@inject QoderAuthService AuthService
@implements IDisposable

<PageTitle>用量记录 - Qoder2API 管理</PageTitle>

@if (!string.IsNullOrEmpty(flashMessage))
{
    <div class="toast-container">
        <div class="toast-notice @(flashIsError ? "toast-err" : "toast-ok")" role="alert">
            <div class="toast-icon">
                @if (flashIsError)
                {
                    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" /></svg>
                }
                else
                {
                    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
                }
            </div>
            <span class="toast-content">@flashMessage</span>
            <button type="button" class="toast-close" @onclick="DismissToast" aria-label="关闭">
                <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14"><path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/></svg>
            </button>
        </div>
    </div>
}

<!-- Usage Metric Summary Cards -->
<div class="card-grid">
    <div class="metric-box">
        <div class="metric-label">总请求次数</div>
        <div class="metric-value">@records.Count</div>
        <div class="metric-sub">本地 SQLite 审计记录</div>
    </div>

    <div class="metric-box">
        <div class="metric-label">累计消耗 Tokens</div>
        <div class="metric-value">@records.Sum(r => (long)r.TotalTokens).ToString("N0")</div>
        <div class="metric-sub">提示词 + 生成结果</div>
    </div>

    <div class="metric-box">
        <div class="metric-label">深度思考推理 Tokens</div>
        <div class="metric-value">@records.Sum(r => (long)r.ReasoningTokens).ToString("N0")</div>
        <div class="metric-sub">DeepSeek-R1 思维链生成量</div>
    </div>

    <div class="metric-box">
        <div class="metric-label">提示缓存命中</div>
        <div class="metric-value" style="color: var(--ok);">
            @(records.Sum(r => (long)r.CachedTokens).ToString("N0"))
        </div>
        <div class="metric-sub">
            @{
                long totalPrompt = records.Sum(r => (long)r.PromptTokens);
                long totalCached = records.Sum(r => (long)r.CachedTokens);
            }
            @(totalPrompt > 0 ? $"占输入 {totalCached * 100.0 / totalPrompt:F0}%" : "暂无数据")
        </div>
    </div>

    <div class="metric-box">
        <div class="metric-label">平均首字延迟</div>
        <div class="metric-value">
            @{
                var ttft = records.Where(r => r.FirstTokenMs > 0).Select(r => r.FirstTokenMs).ToList();
            }
            @(ttft.Count > 0 ? $"{ttft.Average():F0} ms" : "—")
        </div>
        <div class="metric-sub">上游 event:finish 的 firstTokenDuration</div>
    </div>

    <div class="metric-box">
        <div class="metric-label">平均响应延迟</div>
        <div class="metric-value">
            @(records.Count > 0 ? $"{(records.Average(r => r.LatencyMs)):F0} ms" : "0 ms")
        </div>
        <div class="metric-sub">包含首字与全文本传输</div>
    </div>
</div>

<section class="card">
    <div class="card-title">
        <div>
            <h2 style="margin: 0; display: inline-block;">最近调用明细</h2>
        </div>
        <div class="row-actions">
            <button type="button" class="secondary" @onclick="ReloadData">
                <i class="bi bi-arrow-repeat"></i> 刷新
            </button>
            <button type="button" class="danger" @onclick="ClearRecords">
                清空日志
            </button>
        </div>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>请求时间</th>
                    <th>调用模型</th>
                    <th>输入 Tokens</th>
                    <th>生成 Tokens</th>
                    <th>思考 Tokens</th>
                    <th>缓存命中</th>
                    <th>首字延迟</th>
                    <th>总延迟</th>
                    <th>供应商</th>
                    <th>状态</th>
                </tr>
            </thead>
            <tbody>
                @if (records.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="muted" style="text-align: center; padding: 2.5rem;">
                            暂无请求记录。使用第三方客户端发起对话后将在此显示。
                        </td>
                    </tr>
                }
                @foreach (var r in records)
                {
                    <tr>
                        <td style="font-size: 0.8rem; color: var(--muted);" class="mono">
                            @r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                        </td>
                        <td>
                            <code class="mono" style="font-weight: 600; color: var(--ink);">@r.Model</code>
                            @* 估算值明确标注：与上游实测值混在一起会让统计失去意义 *@
                            @if (r.UsageSource == "estimated")
                            {
                                <span class="badge pending" style="font-size: 0.65rem; margin-left: 0.25rem;"
                                      title="上游未返回 usage，此行的 token 数为本地估算">估</span>
                            }
                        </td>
                        <td class="mono">@r.PromptTokens</td>
                        <td class="mono">@r.CompletionTokens</td>
                        <td class="mono" style="color: var(--warn);">@(r.ReasoningTokens > 0 ? r.ReasoningTokens.ToString() : "—")</td>
                        <td class="mono" style="color: var(--ok);">@(r.CachedTokens > 0 ? r.CachedTokens.ToString() : "—")</td>
                        <td class="mono" style="font-size: 0.8rem;">@(r.FirstTokenMs > 0 ? $"{r.FirstTokenMs} ms" : "—")</td>
                        <td class="mono">@(r.LatencyMs) ms</td>
                        <td class="supplier-cell" title="@SupplierTitle(r.AccountUid)">
                            @SupplierName(r.AccountUid)
                        </td>
                        <td>
                            @if (r.Status == "success")
                            {
                                <span class="badge active">成功</span>
                            }
                            else if (r.Status == "cancelled")
                            {
                                <span class="badge pending" title="客户端主动断开，非账号或上游故障">已取消</span>
                            }
                            else
                            {
                                <span class="badge disabled" title="@r.ErrorMessage">失败</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private List<UsageRecord> records = [];
    private string? flashMessage;
    private bool flashIsError = false;

    protected override void OnInitialized()
    {
        ReloadData();
    }

    private void ReloadData()
    {
        records = AuthService.Database.GetRecentUsage(100);
        // 用量记录只存账号 Id，展示名要另查一次（每页一次，不是每请求一次）。
        _supplierById = AuthService.Database.GetAllAccounts()
            .ToDictionary(a => a.Id, BuildSupplier, StringComparer.Ordinal);
    }

    private Dictionary<string, Supplier> _supplierById = new(StringComparer.Ordinal);

    /// <summary>邮箱优先（唯一且可读），其次用户名，最后 UID。悬停信息含三者全值。</summary>
    private static Supplier BuildSupplier(AccountRecord a)
    {
        string email = (a.UserEmail ?? "").Trim();
        string name = (a.UserName ?? "").Trim();

        string label = email.Length > 0 ? email
            : name.Length > 0 ? name
            : a.Id;

        var parts = new List<string>();
        if (email.Length > 0) parts.Add(email);
        if (name.Length > 0) parts.Add(name);
        parts.Add(a.Id);
        return new Supplier(label, string.Join(" · ", parts));
    }

    /// <summary>
    /// 供应商列。邮箱优先——它比用户名更适合标识账号：用户名可能重复或为空，邮箱是唯一的。
    /// 都没有则回落 UID（历史记录可能来自已删除的账号）。
    /// </summary>
    private string SupplierName(string? accountId)
    {
        if (string.IsNullOrEmpty(accountId))
        {
            return "—";
        }
        return _supplierById.TryGetValue(accountId, out var s) ? s.Label : ShortUid(accountId);
    }

    /// <summary>悬停显示完整信息：邮箱 + 用户名 + UID。</summary>
    private string SupplierTitle(string? accountId)
    {
        if (string.IsNullOrEmpty(accountId))
        {
            return "";
        }
        return _supplierById.TryGetValue(accountId, out var s) ? s.Title : "已删除的账号 " + accountId;
    }

    private static string ShortUid(string? uid) =>
        string.IsNullOrEmpty(uid) ? "—" : (uid.Length > 8 ? uid[..8] : uid);

    private readonly record struct Supplier(string Label, string Title);

    private CancellationTokenSource? _toastCts;

    private void ShowToast(string message, bool isError = false, int timeoutMs = 3000)
    {
        flashMessage = message;
        flashIsError = isError;
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(timeoutMs, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        flashMessage = null;
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private void DismissToast()
    {
        _toastCts?.Cancel();
        flashMessage = null;
    }

    private void ClearRecords()
    {
        AuthService.Database.ClearUsageRecords();
        ShowToast("已清空用量历史记录。");
        ReloadData();
    }

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }
}
