@* 分页控件：显示区间、每页条数、页码跳转。 *@

<div class="pager">
    <div class="pager-info">
        @if (Total > 0)
        {
            <span>第 <b>@From</b>–<b>@To</b> 条，共 <b>@Total</b> 条</span>
        }
        else
        {
            <span class="muted">共 0 条</span>
        }

        <label class="pager-size">
            每页
            <select value="@PageSize" @onchange="OnPageSizeChanged">
                @foreach (int n in SizeOptions)
                {
                    <option value="@n">@n</option>
                }
            </select>
        </label>
    </div>

    @if (TotalPages > 1)
    {
        <nav class="pager-nav">
            <button type="button" disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)"
                    title="上一页" aria-label="上一页">‹</button>

            @foreach (int p in VisiblePages)
            {
                if (p == 0)
                {
                    <span class="gap">…</span>
                }
                else
                {
                    <button type="button" class="@(p == Page ? "on" : null)"
                            @onclick="() => Go(p)">@p</button>
                }
            }

            <button type="button" disabled="@(Page >= TotalPages)" @onclick="() => Go(Page + 1)"
                    title="下一页" aria-label="下一页">›</button>
        </nav>
    }
</div>

@code {
    [Parameter] public int Total { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private static readonly int[] DefaultSizes = [10, 20, 50, 100];
    private IEnumerable<int> SizeOptions =>
        PageSize > 0 && !DefaultSizes.Contains(PageSize) ? DefaultSizes.Append(PageSize).OrderBy(x => x) : DefaultSizes;

    private int TotalPages => PageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling(Total / (double)PageSize));

    private int From => Total == 0 ? 0 : (Page - 1) * PageSize + 1;
    private int To => Math.Min(Page * PageSize, Total);

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int Window = 2;
            int total = TotalPages;
            if (total <= 7)
            {
                return Enumerable.Range(1, total);
            }

            var pages = new List<int> { 1 };
            int start = Math.Max(2, Page - Window);
            int end = Math.Min(total - 1, Page + Window);
            if (start > 2)
            {
                pages.Add(0); // 0 表示省略号
            }
            pages.AddRange(Enumerable.Range(start, end - start + 1));
            if (end < total - 1)
            {
                pages.Add(0);
            }
            pages.Add(total);
            return pages;
        }
    }

    private void Go(int page)
    {
        int clamped = Math.Clamp(page, 1, TotalPages);
        if (clamped != Page)
        {
            PageChanged.InvokeAsync(clamped);
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size) && size > 0)
        {
            PageSizeChanged.InvokeAsync(size);
        }
    }
}
